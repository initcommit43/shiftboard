# Local development defaults for docker compose. Copy to .env and adjust.
# Never put real credentials here; .env is not committed.

DB_NAME=shiftboard
DB_USER=shiftboard
DB_PASSWORD=shiftboard

# Signs the access tokens, at least 32 characters. This value is a placeholder for local
# development; any other environment needs its own, e.g. from `openssl rand -base64 48`.
JWT_SECRET=local-development-only-jwt-secret-0000

# Password of the fictional demo accounts that are seeded on local startup.
SEED_PASSWORD=shiftboard-demo

# Path to the service account key of the Firebase project, as seen by the backend. Empty: push
# notifications are only logged (ADR 0024). The key file itself is never committed.
FCM_CREDENTIALS_FILE=

# Ports published on the host
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8080
